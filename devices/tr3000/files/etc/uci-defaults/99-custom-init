#!/bin/sh

set -eu


# ============================================================
# Default configuration
# ============================================================

CONFIG_FILE="/etc/custom-build.conf"

LAN_IP="192.168.88.1"
HOSTNAME="tr3000"

TIMEZONE="CST-8"
ZONENAME="Asia/Shanghai"


# ------------------------------------------------------------
# Load configuration generated by GitHub Actions
# ------------------------------------------------------------

if [ -f "$CONFIG_FILE" ]; then

    . "$CONFIG_FILE"

fi


logger \
    -t custom-init \
    "Starting first boot initialization"


# ============================================================
# System settings
# ============================================================

uci -q set \
    system.@system[0].hostname="$HOSTNAME"

uci -q set \
    system.@system[0].timezone="$TIMEZONE"

uci -q set \
    system.@system[0].zonename="$ZONENAME"


# ============================================================
# LAN settings
# ============================================================

uci -q set \
    network.lan.ipaddr="$LAN_IP"

uci -q set \
    network.lan.netmask="255.255.255.0"


# ============================================================
# Disable IPv6
# ============================================================


# ------------------------------------------------------------
# Remove WAN6
# ------------------------------------------------------------

uci -q delete \
    network.wan6


# ------------------------------------------------------------
# Remove IPv6 ULA prefix
# ------------------------------------------------------------

uci -q delete \
    network.globals.ula_prefix


# ------------------------------------------------------------
# Disable IPv6 services on LAN
# ------------------------------------------------------------

uci -q set \
    dhcp.lan.ra='disabled'

uci -q set \
    dhcp.lan.dhcpv6='disabled'

uci -q set \
    dhcp.lan.ndp='disabled'


# ------------------------------------------------------------
# Remove unused IPv6 options
# ------------------------------------------------------------

uci -q delete \
    dhcp.lan.ra_slaac

uci -q delete \
    dhcp.lan.ra_flags


# ============================================================
# Commit UCI
# ============================================================

uci commit system

uci commit network

uci commit dhcp


# ============================================================
# FRP
#
# FRP 是设备恢复和远程控制通道。
#
# /etc/config/frpc 已经在构建阶段写入 SquashFS，
# 因此恢复出厂后也会重新恢复。
# ============================================================


# ------------------------------------------------------------
# Verify frpc
# ------------------------------------------------------------

if [ ! -x /usr/bin/frpc ]; then

    logger \
        -t custom-init \
        "ERROR: /usr/bin/frpc missing"

    exit 1

fi


# ------------------------------------------------------------
# Verify FRP configuration
# ------------------------------------------------------------

if [ ! -f /etc/config/frpc ]; then

    logger \
        -t custom-init \
        "ERROR: /etc/config/frpc missing"

    exit 1

fi


# ------------------------------------------------------------
# Verify token exists
#
# 只检查，不输出真实 token。
# ------------------------------------------------------------

if ! uci -q get frpc.common.token >/dev/null 2>&1; then

    logger \
        -t custom-init \
        "ERROR: FRP token missing"

    exit 1

fi


# ============================================================
# Device ID
# ============================================================
#
# 与 MT3600BE 当前逻辑一致：
#
# 使用 eth0 MAC 地址最后 6 个十六进制字符。
#
# 例如：
#
#   D4:0D:AB:8F:AE:FD
#
# 得到：
#
#   8FAEFD
#
# ============================================================

DEVICE_ID="$(
    tr -d ':' \
        < /sys/class/net/eth0/address \
        | tail -c 7
)"


logger \
    -t custom-init \
    "Device ID: ${DEVICE_ID}"


# ============================================================
# Unique FRP proxy name
# ============================================================
#
# 最终名称例如：
#
#   tr3000-8FAEFD-ssh
#
# ============================================================

uci set \
    frpc.ssh.name="tr3000-${DEVICE_ID}-ssh"


uci commit frpc


# ------------------------------------------------------------
# FRP 配置包含 Token。
#
# 首次启动写入 overlay 后限制为 root 可读写。
# ------------------------------------------------------------

chmod 0600 \
    /etc/config/frpc


# ============================================================
# Enable FRP
# ============================================================

/etc/init.d/frpc enable


# ------------------------------------------------------------
# Start FRP immediately
#
# 如果 WAN 当前还没有准备好，
# frpc + procd 会继续重试。
# ------------------------------------------------------------

/etc/init.d/frpc restart \
    || /etc/init.d/frpc start \
    || true


logger \
    -t custom-init \
    "First boot initialization completed"


exit 0