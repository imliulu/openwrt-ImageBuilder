#!/bin/sh

set -eu

CONFIG_FILE="/etc/custom-build.conf"

LAN_IP="192.168.88.1"
HOSTNAME="mt3600be"
TIMEZONE="CST-8"
ZONENAME="Asia/Shanghai"

if [ -f "$CONFIG_FILE" ]; then
    . "$CONFIG_FILE"
fi

logger -t custom-init "Starting first boot initialization"

uci -q set system.@system[0].hostname="$HOSTNAME"
uci -q set system.@system[0].timezone="$TIMEZONE"
uci -q set system.@system[0].zonename="$ZONENAME"
uci -q set network.lan.ipaddr="$LAN_IP"

uci commit system
uci commit network

# Ensure required files exist.
[ -x /usr/bin/frpc ] || exit 1
[ -f /etc/config/frpc ] || exit 1

[ -x /usr/bin/ssserver ] || exit 1
[ -f /etc/shadowsocks-rust/config.json ] || exit 1
[ -x /etc/init.d/shadowsocks-rust ] || exit 1

# Enable services for every subsequent boot.
/etc/init.d/frpc enable
/etc/init.d/shadowsocks-rust enable

logger -t custom-init "First boot initialization completed"

exit 0
