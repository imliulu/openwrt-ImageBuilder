#!/bin/sh
set -eu

CONFIG_FILE="/etc/custom-build.conf"

# Defaults are used if the build-time config file is missing.
LAN_IP="192.168.88.1"
HOSTNAME="mt3600be"
TIMEZONE="CST-8"
ZONENAME="Asia/Shanghai"

if [ -f "$CONFIG_FILE" ]; then
    # This file is generated by the CI workflow and contains only shell-safe values.
    . "$CONFIG_FILE"
fi

uci -q set system.@system[0].hostname="$HOSTNAME"
uci -q set system.@system[0].timezone="$TIMEZONE"
uci -q set system.@system[0].zonename="$ZONENAME"
uci -q set network.lan.ipaddr="$LAN_IP"

uci commit system
uci commit network

/etc/init.d/shadowsocks-rust enable
/etc/init.d/frpc enable 2>/dev/null || true


exit 0
