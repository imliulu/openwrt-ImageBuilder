config init
	option stdout '1'
	option stderr '1'
	option respawn '1'

config conf 'common'
	option server_addr '__FRP_SERVER_ADDR__'
	option server_port '7000'
	option authentication_method 'token'
	option token_source_type 'file'
	option token_source_file_path '/etc/frp/token'
	option login_fail_exit 'false'
	option protocol 'tcp'
	option tls_enable 'true'
	option log_file 'console'
	option log_level 'info'
	option authenticate_heartbeats '1'
	option authenticate_new_work_conns '1'

config conf 'ssh'
	option name 'mt3600be-ssh'
	option type 'tcp'
	option local_ip '127.0.0.1'
	option local_port '22'
	option remote_port '0'
	option enabled 'true'
